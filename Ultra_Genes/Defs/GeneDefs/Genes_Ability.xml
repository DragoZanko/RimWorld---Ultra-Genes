<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <GeneDef>
    <defName>UG_BioElectricThighs</defName>
    <label>bio-electric thighs</label>
    <description>Carriers of this gene can defend themselves with electric shocks from their hips and thighs.</description>
    <iconPath>Genes/BioElectricThighs</iconPath>
    <displayCategory>Ability</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>-1</biostatMet>
    <canGenerateInGeneSet>true</canGenerateInGeneSet>
    <abilities>
      <li>UG_ElectricShock</li>
    </abilities>
    <descriptionHyperlinks>
      <AbilityDef>UG_ElectricShock</AbilityDef>
    </descriptionHyperlinks>
  </GeneDef>

  <HediffDef>
    <defName>UG_ElectricShockHediff</defName>
    <label>electric shock</label>
    <defaultLabelColor>(150, 50, 250)</defaultLabelColor>
    <description>Electrically overstimulated nervous system.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1.0</initialSeverity>
    <stages>
      <li>
        <becomeVisible>true</becomeVisible>
        <capMods>
          <li><capacity>Consciousness</capacity><offset>-0.20</offset></li>
          <li><capacity>Sight</capacity><offset>-0.80</offset></li>
          <li><capacity>Hearing</capacity><offset>-1.0</offset></li>
          <li><capacity>Moving</capacity><offset>-1.0</offset></li>
          <li><capacity>Manipulation</capacity><offset>-1.0</offset></li>
          <li><capacity>Talking</capacity><offset>-1.0</offset></li>
          <li><capacity>BloodPumping</capacity><offset>-0.50</offset></li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>UG_ElectricShockFailHediff</defName>
    <label>localized shock</label>
    <defaultLabelColor>(150, 50, 250)</defaultLabelColor>
    <description>A failed discharge that caused localized muscular paralysis in a limb.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <initialSeverity>1.0</initialSeverity>
    <stages>
      <li>
        <becomeVisible>true</becomeVisible>
        <partEfficiencyOffset>-1.0</partEfficiencyOffset>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

</Defs>