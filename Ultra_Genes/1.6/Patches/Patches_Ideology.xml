<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Ludeon.RimWorld.Ideology</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/FactionDef[defName="NudistTribe" and not(xenotypeSet)]</xpath>
          <value>
            <xenotypeSet />
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/FactionDef[defName="NudistTribe"]/xenotypeSet[not(xenotypeChances)]</xpath>
          <value>
            <xenotypeChances />
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/FactionDef[defName="NudistTribe"]/xenotypeSet/xenotypeChances</xpath>
          <value>
            <Baseliner>40</Baseliner>
            <UG_Nudis>0.007</UG_Nudis>
          </value>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>