<?xml version="1.0" encoding="utf-8" ?>
<Patch>

<Operation Class="PatchOperationFindMod">
  <mods><li>World of Naruto</li></mods>
  <match Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationAdd">
        <xpath>Defs/GeneDef[defName="UG_TwistedHorns"]</xpath>
        <value>
          <displayCategory>Miscellaneous</displayCategory>
          <biostatCpx>1</biostatCpx>
          <biostatMet>-1</biostatMet>
          <statOffsets>
            <WN_MaxChakraEnergy>50</WN_MaxChakraEnergy>
          </statOffsets>
          <forcedTraits>
            <li><def>WN_Chakra</def></li>
          </forcedTraits>
        </value>
      </li>
    </operations>
  </match>
</Operation>

</Patch>