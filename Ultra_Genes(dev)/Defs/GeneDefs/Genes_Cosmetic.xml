<?xml version="1.0" encoding="utf-8"?>
<Defs>

<GeneDef Name="UG_HairBase" ParentName="GeneHairColorBase" Abstract="True">
  <description>Carriers of this gene have a particular hair color. With multiple hair color genes, one is randomly selected.</description>
  <displayCategory>Cosmetic_Hair</displayCategory>
  <endogeneCategory>HairColor</endogeneCategory>
  <biostatCpx>0</biostatCpx>
  <biostatMet>0</biostatMet>
  <canGenerateInGeneSet>true</canGenerateInGeneSet> 
  <selectionWeight>0.05</selectionWeight>
  <exclusionTags>
    <li>HairColor</li>
  </exclusionTags>
</GeneDef>

  <GeneDef ParentName="UG_HairBase">
    <defName>UG_MammothBlondeHair</defName>
    <label>Mammoth Blonde Hair</label>
    <hairColorOverride>(236, 219, 211)</hairColorOverride>
    <selectionWeightFactorDarkSkin>0</selectionWeightFactorDarkSkin>
    <randomBrightnessFactor>0</randomBrightnessFactor>
    <displayOrderInCategory>49</displayOrderInCategory>
  </GeneDef>

  <GeneDef ParentName="UG_HairBase">
    <defName>UG_PlatinePinkHair</defName>
    <label>platine pink hair</label>
    <hairColorOverride>(163, 139, 145)</hairColorOverride>
    <selectionWeightFactorDarkSkin>0</selectionWeightFactorDarkSkin>
    <selectionWeight>0.01</selectionWeight>
    <randomBrightnessFactor>0</randomBrightnessFactor>
    <displayOrderInCategory>11</displayOrderInCategory>
  </GeneDef>

  <GeneDef ParentName="UG_HairBase">
    <defName>UG_MilitaryBlondeHair</defName>
    <label>military blonde hair</label>
    <hairColorOverride>(119, 117, 95)</hairColorOverride>
    <randomBrightnessFactor>0</randomBrightnessFactor>
    <displayOrderInCategory>71</displayOrderInCategory>
    <selectionWeightCultist>0</selectionWeightCultist>
  </GeneDef>

  <GeneDef ParentName="UG_HairBase">
    <defName>UG_OceanicDeepIceHair</defName>
    <label>oceanic deep ice hair</label>
    <hairColorOverride>(10, 31, 46)</hairColorOverride>
    <selectionWeight>0.02</selectionWeight>
    <displayOrderInCategory>139</displayOrderInCategory>
    <selectionWeightCultist>0</selectionWeightCultist>
  </GeneDef>

  <GeneDef ParentName="UG_HairBase">
    <defName>UG_InfernalHair</defName>
    <label>infernal hair</label>
    <hairColorOverride>(128, 0, 32)</hairColorOverride>
    <selectionWeight>0.03</selectionWeight>
    <displayOrderInCategory>189</displayOrderInCategory>
    <selectionWeightCultist>0</selectionWeightCultist>
  </GeneDef>

  <GeneDef ParentName="UG_HairBase">
    <defName>UG_DeepInfernoHair</defName>
    <label>deep inferno hair</label>
    <hairColorOverride>(84, 13, 23)</hairColorOverride>
    <selectionWeight>0.02</selectionWeight>
    <displayOrderInCategory>188</displayOrderInCategory>
    <selectionWeightCultist>0</selectionWeightCultist>
  </GeneDef>

  <GeneDef ParentName="GeneSkinColorOverride">
    <defName>UG_SkinPink</defName>
    <label>pink skin</label>
    <labelShortAdj>pink</labelShortAdj>
    <description>Carriers of this gene produce a pigment that gives their skin a pink color.</description>
    <randomBrightnessFactor>0</randomBrightnessFactor>
    <skinColorOverride>(233, 173, 255)</skinColorOverride>
    <displayOrderInCategory>99</displayOrderInCategory>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>rose</symbol></li>
        <li><symbol>pink</symbol></li>
        <li><symbol>blush</symbol></li>
        <li><symbol>peach</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>rose</symbol></li>
        <li><symbol>gum</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>







<GeneDef ParentName="GeneHeadboneBase">
    <defName>UG_TwistedHorns</defName>
    <label>twisted horns</label>
    <description>Carriers of this gene grow two hollow horns protruding from the forehead that can store energy.</description>
    <iconPath>Genes/TwistedHorns_Icon</iconPath>
    <canGenerateInGeneSet>true</canGenerateInGeneSet>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>Genes/TwistedHorns</texPath>
        <color>(255, 255, 255)</color>
        <parentTagDef>Head</parentTagDef>
        <drawSize>(0.625,0.625)</drawSize>
        <drawData>
          <defaultData>
            <layer>80</layer>
          </defaultData>
          <dataNorth>
            <layer>10</layer>
          </dataNorth>
        </drawData>
      </li>
    </renderNodeProperties>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>twist</symbol></li>
        <li><symbol>hollow</symbol></li>
        <li><symbol>ravager</symbol></li>
        <li><symbol>demon</symbol></li>
        <li><symbol>devil</symbol></li>
        <li><symbol>lightning</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>horn</symbol></li>
        <li><symbol>spike</symbol></li>
        <li><symbol>rod</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

  <GeneDef ParentName="GeneEarsBase">
    <defName>UG_EarsHorse</defName>
    <label>horse ears</label>
    <description>Carriers of this gene have horse-like ears.</description>
    <iconPath>Genes/EarsHorse_Icon</iconPath>
    <renderNodeProperties>
      <li>
        <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
        <workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
        <texPath>Genes/EarsHorse</texPath>
        <colorType>Hair</colorType>
        <parentTagDef>Head</parentTagDef>
        <drawSize>(0.752,0.752)</drawSize>
        <drawData>
          <defaultData>
            <layer>70</layer>
          </defaultData>
        </drawData>
      </li>
    </renderNodeProperties>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>horse</symbol></li>
        <li><symbol>foal</symbol></li>
        <li><symbol>mare</symbol></li>
        <li><symbol>stallion</symbol></li>
      </prefixSymbols>
      <suffixSymbols>
        <li><symbol>ear</symbol></li>
        <li><symbol>hoof</symbol></li>
        <li><symbol>horse</symbol></li>
        <li><symbol>foal</symbol></li>
        <li><symbol>mare</symbol></li>
        <li><symbol>stallion</symbol></li>
      </suffixSymbols>
    </symbolPack>
  </GeneDef>

</Defs>