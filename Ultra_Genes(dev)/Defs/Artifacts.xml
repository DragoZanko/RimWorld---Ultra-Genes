<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>UG_ArchotechGeneIntegrator</defName>
    <label>archotech gene integrator</label>
    <description>A one-use focused ultrasonic genetic effector. The surgical operator pulse reprograms genetic originality.</description>
    <techLevel>Archotech</techLevel>
    <graphicData>
      <texPath>Genes/ArchotechGeneIntegrator</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <resourceReadoutPriority>Middle</resourceReadoutPriority>
    <stackLimit>1</stackLimit>
    <tradeNeverStack>true</tradeNeverStack>
    <useHitPoints>true</useHitPoints>
    <thingCategories>
      <li>Artifacts</li>
    </thingCategories>
    <tradeTags>
      <li>Artifact</li>
    </tradeTags>
    <statBases>
      <Mass>0.5</Mass>
      <MarketValue>1500</MarketValue>
      <MaxHitPoints>80</MaxHitPoints>
      <StyleDominance MayRequire="Ludeon.RimWorld.Ideology">10</StyleDominance>
    </statBases>
    <drawGUIOverlay>false</drawGUIOverlay>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseArtifact</useJob>
        <useLabel>Use archotech gene integrator</useLabel>
        <useDuration>150</useDuration>
        <showUseGizmo>true</showUseGizmo>
      </li>
      <li Class="CompProperties_UseEffect">
        <compClass>DragoZanko.Ultra.Genes.CompTargetEffect_IntegrateGenes</compClass>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf" />
      <li Class="CompProperties_UseEffectArtifact">
        <sound>PsychicAnimalPulserCast</sound>
      </li>
      <li Class="CompProperties_UseEffectPlayWarmupSound">
        <warmupSound>PsychicArtifactWarmupSustained</warmupSound>
      </li>
    </comps>
  </ThingDef>

</Defs>