<?xml version="1.0" encoding="utf-8"?>
<Patch>

<Operation Class="PatchOperationAdd">
  <xpath>Defs/GeneDef[defName="Unstoppable"]</xpath>
  <value>
    <exclusionTags>
      <li>stagger</li>
    </exclusionTags>
  </value>
</Operation>

<Operation Class="PatchOperationReplace">
    <xpath>Defs/GeneDef[defName="Ears_Cat"]/renderNodeProperties/li/texPath</xpath>
    <value>
      <texPath>Genes/EarsCatFurnishings</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/GeneDef[defName="Ears_Cat"]/renderNodeProperties/li/colorType</xpath>
    <value>
      <colorType>Hair</colorType>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/GeneDef[defName="Ears_Cat"]/renderNodeProperties/li</xpath>
    <value>
      <shaderTypeDef>Cutout</shaderTypeDef>
      <drawSize>(0.625,0.625)</drawSize>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/GeneDef[defName="Ears_Floppy"]/renderNodeProperties/li/texPath</xpath>
    <value>
      <texPath>Genes/EarsShepherdFloppy</texPath>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/GeneDef[defName="Ears_Floppy"]/renderNodeProperties/li/colorType</xpath>
    <value>
      <colorType>Hair</colorType>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/GeneDef[defName="Ears_Floppy"]/renderNodeProperties/li</xpath>
    <value>
      <shaderTypeDef>Cutout</shaderTypeDef>
      <drawSize>(0.625,0.625)</drawSize>
    </value>
  </Operation>

<Operation Class="PatchOperationAdd">
  <xpath>/Defs/FactionDef[@Name="OutlanderFactionBase"]/xenotypeSet/xenotypeChances</xpath>
    <value>
      <UG_Khorsy>0.01</UG_Khorsy>
    </value>
</Operation>

<Operation Class="PatchOperationAdd">
  <xpath>/Defs/FactionDef[@Name="OutlanderFactionBase"]/xenotypeSet/xenotypeChances</xpath>
    <value>
      <UG_Nudis>0.003</UG_Nudis>
    </value>
</Operation>

</Patch>